# Copy to .env.local and fill in.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: primary model, and the one used if it errors or times out
TRIAGE_MODEL=gemini-3.5-flash-lite
TRIAGE_FALLBACK_MODEL=gemini-3.8-flash

# https://console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Public URL Twilio calls (ngrok URL locally, Vercel URL in prod). Used for signature validation.
PUBLIC_BASE_URL=

# SMS Gateway for Android (Cloud mode) -- the phone's app, Home tab -> Cloud Server
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# App: Settings -> Webhooks -> Signing Key
SMSGATE_SIGNING_KEY=

# Supabase -> Project Settings -> API Keys. URL without /rest/v1.
SUPABASE_URL=
# Secret key (sb_secret_...): server only, never in the dashboard
SUPABASE_SECRET_KEY=
