# Backend config. Copy to .env.local for local runs; the same variables are set
# in the Vercel project for production (redeploy after changing them there).

# --- AI (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Main model and the one used if it errors or times out (triage, follow-ups, insights).
TRIAGE_MODEL=gemini-3.5-flash-lite
TRIAGE_FALLBACK_MODEL=gemini-3.8-flash
# Optional: model for incident analysis (default gemini-3.5-flash-lite).
ANALYSIS_MODEL=

# --- Database (Supabase -> Project Settings -> API Keys) ---
# URL without /rest/v1
SUPABASE_URL=
# Secret key (sb_secret_...): server only, never in the dashboard
SUPABASE_SECRET_KEY=

# --- SMS: SMS Gateway for Android, Cloud mode ---
# Phone app, Home tab
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Phone app, Settings -> Webhooks -> Signing Key. When set, unsigned webhooks are rejected.
SMSGATE_SIGNING_KEY=
# Shown on the landing page, e.g. (213) 555-0142
REPORT_PHONE_NUMBER=

# --- Who the SMS bot answers. Unset both = everyone. ---
# Always answered, comma-separated:
SMS_ALLOWED_NUMBERS=
# Anyone else is answered once their first text starts with this, e.g. "REPORT pothole at ...":
SMS_JOIN_KEYWORD=

# --- Limits and access ---
# New reports one phone number can open per hour (emergencies always go through)
REPORTS_PER_HOUR=20
# Dashboard origins allowed to call the API (comma-separated). Unset = any origin.
DASHBOARD_ORIGINS=http://localhost:5173
# Set to 1 to log texts instead of sending them (scripts/chat.ts sets this automatically)
SMS_DRY_RUN=

# Public site: where the "Agency portal" link points (default: the deployed dashboard)
NEXT_PUBLIC_DASHBOARD_URL=
